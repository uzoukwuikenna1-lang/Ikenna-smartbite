# Copy to .env and fill in. All optional for local dev — the server falls back
# to an in-memory MongoDB when MONGODB_URI is not set.

# Port the API listens on
PORT=4000

# MongoDB connection string. Leave empty to use an in-memory DB (great for demos).
# For the real thing, create a free MongoDB Atlas M0 cluster and paste its URI:
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/smartbite
MONGODB_URI=

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=dev-secret-change-me

# How long tokens stay valid
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins for CORS (the Expo app). * allows all.
CORS_ORIGIN=*

# Cloudinary (optional, Phase 4 image uploads) — leave empty to skip
CLOUDINARY_URL=
