# Copy to .env — the SmartBite app reads EXPO_PUBLIC_* vars at build time.

# Where the backend API lives.
# - Web / iOS simulator on this same machine: http://localhost:4000 works.
# - Physical phone via Expo Go: use your computer's LAN IP, e.g. http://192.168.1.20:4000
# - Deployed: your Render URL, e.g. https://smartbite-api.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:4000
